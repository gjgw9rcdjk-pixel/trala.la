# Copy to .env.local for local dev, or set these in the Vercel dashboard
# (Settings → Environment Variables) for production.

# Ratings + feedback backend (Vercel KV / Upstash Redis). Vercel adds these
# automatically once you connect a KV store to the project — for local dev,
# pull them down with `vercel env pull .env.local` (see README).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Feedback export (see README "Feedback export"). Pick a long random string
# yourself — anyone with this exact value can read every feedback submission
# via /api/feedback/export?key=..., so keep it private. Leave unset to
# disable the export endpoint entirely (it returns 404).
FEEDBACK_EXPORT_KEY=

# AI deck generator prototype (/create?key=...). Pick a long random string;
# without it (or with a wrong key) /create returns 404.
CREATE_PREVIEW_KEY=
